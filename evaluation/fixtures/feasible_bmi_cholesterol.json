{
  "name": "feasible_bmi_cholesterol",
  "description": "Scenario expecting a feasible counterfactual when BMI and cholesterol are the only mutable features selected by the user.",
  "tags": ["actionability", "feasible", "service", "production"],
  "repeat_count": 1,
  "request": {
    "request_id": "verify-feasible-bmi-cholesterol",
    "target": {
      "target_class": "low_risk",
      "min_target_probability": 0.5
    },
    "instance": {
      "features": {
        "age": 45,
        "smoking_status": 0,
        "is_cholesterol": 1,
        "is_macrosomic_baby": 0,
        "moderate_physical_activity_frequency": 1,
        "is_bloodline": 0,
        "brinkman_index": 0,
        "BMI": 31.2,
        "is_hypertension": 1
      }
    },
    "constraints": {
      "mutable_allowed": ["BMI", "is_cholesterol"]
    }
  },
  "expectation": {
    "expected_status": "FEASIBLE",
    "expected_reason_codes": ["OK"],
    "no_solution_expected": false
  }
}
