{
  "name": "latency_infeasible_target_unreachable_bmi_only",
  "description": "Latency scenario for infeasible handling when only BMI is mutable and the target is too strict.",
  "tags": ["latency", "performance", "backend", "production", "infeasible"],
  "repeat_count": 10,
  "request": {
    "request_id": "latency-infeasible-target-unreachable-bmi-only",
    "target": {
      "target_class": "low_risk",
      "min_target_probability": 0.9
    },
    "instance": {
      "features": {
        "age": 45,
        "smoking_status": 0,
        "is_cholesterol": 1,
        "is_macrosomic_baby": 0,
        "moderate_physical_activity_frequency": 1,
        "is_bloodline": 0,
        "brinkman_index": 0,
        "BMI": 31.2,
        "is_hypertension": 1
      }
    },
    "constraints": {
      "mutable_allowed": ["BMI"]
    },
    "generation": {
      "timeout_ms": 5000
    }
  },
  "expectation": {
    "expected_status": "INFEASIBLE",
    "expected_reason_codes": ["TARGET_UNREACHABLE_UNDER_CONSTRAINTS"],
    "no_solution_expected": true
  }
}
