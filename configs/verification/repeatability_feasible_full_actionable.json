{
  "name": "repeatability_feasible_full_actionable",
  "description": "Repeatability scenario for a poor-risk profile when all actionable mutable features are selected by the user.",
  "tags": ["repeatability", "feasible", "service", "production"],
  "repeat_count": 10,
  "request": {
    "request_id": "verify-repeatability-feasible-full-actionable",
    "target": {
      "target_class": "low_risk",
      "min_target_probability": 0.5
    },
    "instance": {
      "features": {
        "age": 45,
        "smoking_status": 2,
        "is_cholesterol": 1,
        "is_macrosomic_baby": 0,
        "moderate_physical_activity_frequency": 1,
        "is_bloodline": 0,
        "brinkman_index": 3,
        "BMI": 31.2,
        "is_hypertension": 1
      }
    },
    "constraints": {
      "mutable_allowed": ["smoking_status", "BMI", "moderate_physical_activity_frequency", "is_hypertension", "is_cholesterol"]
    }
  },
  "expectation": {
    "expected_status": "FEASIBLE",
    "expected_reason_codes": ["OK"],
    "no_solution_expected": false
  }
}
