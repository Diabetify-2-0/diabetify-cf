{
  "name": "infeasible_target_unreachable_bmi_only",
  "description": "Scenario expecting infeasible handling when only BMI is mutable and the requested probability target is too strict to reach.",
  "tags": ["actionability", "infeasible", "target-unreachable", "service", "production"],
  "repeat_count": 1,
  "request": {
    "request_id": "verify-infeasible-target-unreachable-bmi-only",
    "target": {
      "target_class": "low_risk",
      "min_target_probability": 0.9
    },
    "instance": {
      "features": {
        "age": 45,
        "smoking_status": 0,
        "is_cholesterol": 1,
        "is_macrosomic_baby": 0,
        "moderate_physical_activity_frequency": 1,
        "is_bloodline": 0,
        "brinkman_index": 0,
        "BMI": 31.2,
        "is_hypertension": 1
      }
    },
    "constraints": {
      "immutable_features": ["age", "is_bloodline", "is_macrosomic_baby", "brinkman_index"],
      "mutable_allowed": ["BMI"]
    },
    "generation": {
      "method": "nearest_neighbor_projection",
      "random_seed": 42,
      "timeout_ms": 5000
    }
  },
  "expectation": {
    "expected_status": "INFEASIBLE",
    "expected_reason_codes": ["TARGET_UNREACHABLE_UNDER_CONSTRAINTS"],
    "no_solution_expected": true
  }
}
