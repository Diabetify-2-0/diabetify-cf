{
  "name": "feasible_bmi_activity_repeatability",
  "description": "Repeatability scenario using the same feasible BMI and activity request across multiple runs.",
  "tags": ["feasible", "repeatability", "service", "production"],
  "repeat_count": 10,
  "request": {
    "request_id": "verify-feasible-bmi-activity-repeatability",
    "model_version": "xgb_v1",
    "target": {
      "target_class": "low_risk",
      "min_target_probability": 0.5
    },
    "instance": {
      "features": {
        "age": 45,
        "smoking_status": 0,
        "is_cholesterol": 1,
        "is_macrosomic_baby": 0,
        "moderate_physical_activity_frequency": 1,
        "is_bloodline": 0,
        "brinkman_index": 0,
        "BMI": 31.2,
        "is_hypertension": 1
      }
    },
    "constraints": {
      "immutable_features": ["age", "is_bloodline", "is_macrosomic_baby", "brinkman_index"],
      "mutable_allowed": ["BMI", "moderate_physical_activity_frequency", "is_hypertension", "is_cholesterol"],
      "must_not_change": []
    }
  },
  "expectation": {
    "expected_status": "FEASIBLE",
    "expected_reason_codes": ["OK"],
    "no_solution_expected": false
  }
}
