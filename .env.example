# Core runtime
APP_ENV=dev
CF_LOG_LEVEL=INFO

# RabbitMQ
RABBITMQ_URL=amqp://admin:password123@localhost:5672/
CF_REQUEST_QUEUE=ml.cf.request
CF_RESPONSE_QUEUE=ml.cf.response

# Worker behavior
CF_MAX_RABBITMQ_RETRIES=5
CF_RABBITMQ_RETRY_DELAY_SEC=5
CF_PREFETCH_COUNT=1

# Engine settings
CF_DEFAULT_TOTAL_CFS=3
CF_REQUEST_TIMEOUT_MS=5000
CF_MAX_LOF_SCORE=2.5

# Prescriptive planner
CF_PLANNER_ENABLED=true
CF_PLANNER_PROVIDER=template
CF_PLANNER_MODEL=gpt-4o-mini
CF_PLANNER_TIMEOUT_MS=4000
CF_PLANNER_TEMPERATURE=0.2
CF_PLANNER_MAX_STEPS=6
CF_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=

# Artifacts
CF_MODEL_PATH=
CF_COLUMNS_PATH=
CF_PREPROCESSOR_PATH=
CF_REFERENCE_DATA_PATH=artifacts/reference/reference_data.parquet
CF_FEATURE_REGISTRY_PATH=
