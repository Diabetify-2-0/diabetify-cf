# Core runtime
APP_ENV=dev
CF_LOG_LEVEL=INFO

# RabbitMQ
RABBITMQ_URL=amqp://admin:password123@localhost:5672/
CF_REQUEST_QUEUE=ml.cf.request
CF_RESPONSE_QUEUE=ml.cf.response

# Worker behavior
CF_MAX_RABBITMQ_RETRIES=5
CF_RABBITMQ_RETRY_DELAY_SEC=5
CF_PREFETCH_COUNT=1

# Engine settings
CF_ENGINE_PROVIDER=nn
CF_MAX_LOF_SCORE=2.5
CF_NN_CANDIDATE_POOL_SIZE=256
CF_NN_MAX_NEIGHBORS=64
CF_NN_MAX_CHANGED_FEATURES=3
CF_NN_MIN_REFERENCE_LOW_RISK_PROBABILITY=

# Artifacts
CF_MODEL_PATH=artifacts/models/xg_model.pkl
CF_COLUMNS_PATH=artifacts/models/x_columns.pkl
CF_REFERENCE_DATA_PATH=artifacts/reference/reference_data.parquet
CF_FEATURE_REGISTRY_PATH=configs/feature_registry.json
